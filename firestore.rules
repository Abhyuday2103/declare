rules_version = '2';
// One rules file for the whole Firebase project: Teen Patti (tables) and Declare (dtables).
// Deploying this from either folder keeps both games working.
service cloud.firestore {
  match /databases/{db}/documents {
    match /tables/{tableId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /views/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /secret/{doc} {
        allow read, write: if false;
      }
    }
    match /dtables/{tableId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /views/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /secret/{doc} {
        allow read, write: if false;
      }
    }
  }
}
